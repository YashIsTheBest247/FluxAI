# === Flux Backend ===

# Provider choice — "openai" (paid: GPT-4 + DALL-E 3) or "gemini" (free: Gemini + Pollinations)
PROVIDER=openai

# OpenAI (used when PROVIDER=openai)
OPENAI_API_KEY=
GPT_MODEL=gpt-4o
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1024x1024

# Google Gemini (used when PROVIDER=gemini) — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pollinations.ai (used when PROVIDER=gemini) — no key required
POLLINATIONS_MODEL=flux

# Kokoro TTS (local) - leave blank to fall back to silent track
KOKORO_VOICE=af_bella
KOKORO_MODEL_PATH=

# YouTube — operator runs `python -m app.setup_youtube` once to generate the token
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_AUTO_UPLOAD=true
YOUTUBE_PRIVACY=unlisted
YOUTUBE_CATEGORY_ID=27

# Public channel URL — shown in the nav + hero card. Leave blank to hide.
FLUX_CHANNEL_URL=

# Storage
STORAGE_DIR=storage

# Mock mode: if true, skips all paid API calls and creates placeholder assets
MOCK_MODE=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
